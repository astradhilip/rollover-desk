# Names only. Real values never go in git.
# API: required in production. At least 32 characters.
JWT_SECRET=
# API: SQLite file path by default, or a postgres:// URL.
DATABASE_URL=
# API: comma-separated browser origins allowed to call it.
CORS_ORIGINS=
# API: proxies in front of it, so login limits see the real client address.
TRUST_PROXY_HOPS=
# API: port, and production or development.
PORT=
NODE_ENV=
# Tests only: runs the repository contract tests on PostgreSQL too.
TEST_POSTGRES_URL=
